        "topics": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topics"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "retracted": {
          "title": "Retracted",
          "type": "boolean"
        },
        "curation_status": {
          "$ref": "#/$defs/CurationStatus"
        },
        "review_notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Notes"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "retrieved_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Retrieved At",
          "type": "string"
        },
        "pmid": {
          "pattern": "^[0-9]+$",
          "title": "Pmid",
          "type": "string"
        },
        "pmcid": {
          "pattern": "^PMC[0-9]+$",
          "title": "Pmcid",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "authors": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authors"
        },
        "journal": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journal"
        },
        "published": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published"
        },
        "mesh_terms": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mesh Terms"
        }
      },
      "required": [
        "id",
        "title",
        "source_type",
        "source_uri",
        "language",
        "doc_type",
        "evidence_tier",
        "classification_method",
        "modality",
        "population",
        "audience",
        "license",
        "retracted",
        "curation_status",
        "content_hash",
        "retrieved_at",
        "pmid",
        "pmcid"
      ],
      "title": "PmcFullTextFrontMatter",
      "type": "object"
    },
    "Population": {
      "enum": [
        "adult",
        "pediatric",
        "mixed",
        "unspecified"
      ],
      "title": "Population",
      "type": "string"
    },
