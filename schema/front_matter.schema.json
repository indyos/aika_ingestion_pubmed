{
  "$defs": {
    "Audience": {
      "enum": [
        "clinician",
        "patient"
      ],
      "title": "Audience",
      "type": "string"
    },
    "ClassificationMethod": {
      "enum": [
        "source",
        "rule",
        "llm",
        "manual"
      ],
      "title": "ClassificationMethod",
      "type": "string"
    },
    "CurationStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "title": "CurationStatus",
      "type": "string"
    },
    "DocType": {
      "enum": [
        "guideline",
        "systematic_review",
        "meta_analysis",
        "rct",
        "observational",
        "narrative_review",
        "consensus",
        "patient_education",
        "other"
      ],
      "title": "DocType",
      "type": "string"
    },
    "Modality": {
      "enum": [
        "hemodialysis",
        "peritoneal_dialysis",
        "ckd_non_dialysis",
        "transplant",
        "unspecified"
      ],
      "title": "Modality",
      "type": "string"
    },
    "PdfFrontMatter": {
      "additionalProperties": false,
      "description": "``corpus/pdf-<ente>-<titolo>.md`` — connettore ``aika_ingestion_pdf``.\n\nNessun anno nello slug per scelta esplicita: una nuova edizione dello stesso documento\n**sostituisce sempre** la precedente (stesso `id`), non convive con essa — vedi `CLAUDE.md`.",
      "properties": {
        "schema_version": {
          "default": 2,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^pdf-[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_type": {
          "const": "pdf",
          "title": "Source Type",
          "type": "string"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "original_uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Uri"
        },
        "language": {
          "pattern": "^[a-z]{2}$",
          "title": "Language",
          "type": "string"
        },
        "doc_type": {
          "$ref": "#/$defs/DocType"
        },
        "evidence_tier": {
          "maximum": 5,
          "minimum": 1,
          "title": "Evidence Tier",
          "type": "integer"
        },
        "classification_method": {
          "$ref": "#/$defs/ClassificationMethod"
        },
        "modality": {
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "minItems": 1,
          "title": "Modality",
          "type": "array"
        },
        "population": {
          "$ref": "#/$defs/Population"
        },
        "audience": {
          "$ref": "#/$defs/Audience"
        },
        "topics": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topics"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "retracted": {
          "default": false,
          "title": "Retracted",
          "type": "boolean"
        },
        "curation_status": {
          "$ref": "#/$defs/CurationStatus"
        },
        "review_notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Notes"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "retrieved_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Retrieved At",
          "type": "string"
        },
        "provided_by": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provided By"
        }
      },
      "required": [
        "id",
        "title",
        "source_type",
        "source_uri",
        "language",
        "doc_type",
        "evidence_tier",
        "classification_method",
        "modality",
        "population",
        "audience",
        "license",
        "curation_status",
        "content_hash",
        "retrieved_at"
      ],
      "title": "PdfFrontMatter",
      "type": "object"
    },
    "PmcFullTextFrontMatter": {
      "additionalProperties": false,
      "description": "``corpus/pmid-<PMID>.md`` — full text PMC (Open Access). Stesso contratto sostanziale del\nconnettore pubmed v1; ``aika_ingestion_pubmed`` non lo consuma ancora (vedi docstring modulo).",
